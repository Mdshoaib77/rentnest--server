generator client {

  provider = "prisma-client-js"

}



datasource db {

  provider = "postgresql"

}









// =======================
// USER ROLE
// =======================

enum Role {

  TENANT

  LANDLORD

  ADMIN

}









// =======================
// BOOKING STATUS
// =======================

enum BookingStatus {

  PENDING

  ACCEPTED

  REJECTED

  CANCELLED

  PAID

}









// =======================
// USER MODEL
// =======================

model User {


  id String @id @default(uuid())


  name String


  email String @unique


  password String


  role Role @default(TENANT)



  createdAt DateTime @default(now())


  updatedAt DateTime @updatedAt





  // Landlord properties

  properties Property[]



  // Tenant bookings

  bookings Booking[]





  // DATABASE INDEX

  @@index([role])



}









// =======================
// PROPERTY MODEL
// =======================

model Property {


  id String @id @default(uuid())


  title String


  description String


  location String


  price Float


  bedrooms Int


  bathrooms Int



  landlordId String



  landlord User

    @relation(

      fields: [landlordId],

      references: [id],

      onDelete: Cascade

    )



  bookings Booking[]



  createdAt DateTime @default(now())


  updatedAt DateTime @updatedAt





  // DATABASE INDEX


  @@index([location])


  @@index([price])


  @@index([bedrooms])


  @@index([landlordId])



}









// =======================
// BOOKING MODEL
// =======================

model Booking {


  id String @id @default(uuid())



  tenantId String



  propertyId String





  tenant User

    @relation(

      fields: [tenantId],

      references: [id],

      onDelete: Cascade

    )





  property Property

    @relation(

      fields: [propertyId],

      references: [id],

      onDelete: Cascade

    )





  startDate DateTime



  endDate DateTime



  status BookingStatus @default(PENDING)



  createdAt DateTime @default(now())



  updatedAt DateTime @updatedAt






  // DATABASE INDEX


  @@index([tenantId])


  @@index([propertyId])


  @@index([status])



  @@index([startDate,endDate])



  // Availability checking optimization

  @@index([propertyId,startDate,endDate])



  // Active booking search optimization

  @@index([propertyId,status])



}